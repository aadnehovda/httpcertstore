<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Minimum installed runtime; newer 10.0 patches are accepted. -->
    <RuntimeFrameworkVersion>10.0.14</RuntimeFrameworkVersion>
    <PublishSingleFile>true</PublishSingleFile>
    <UseAppHost>true</UseAppHost>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <PublishDir>bin\publish\win-x64\framework-dependent\</PublishDir>
    <PublishUrl>$(PublishDir)</PublishUrl>
  </PropertyGroup>
</Project>
